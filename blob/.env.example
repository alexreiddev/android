# ---- Site ------------------------------------------------------------
# Canonical URL (used for canonical links, sitemap, OG). Falls back to the Vercel URL.
NEXT_PUBLIC_SITE_URL=

# ---- Supabase (server only) ----------------------------------------------
SUPABASE_URL=
# Forms need: the publishable (anon) key + the website's own secret. The database
# stores only the SHA-256 hash of BLOB_DB_SECRET (table blob_config).
SUPABASE_PUBLISHABLE_KEY=
BLOB_DB_SECRET=
# Optional. Only needed for Atelier image uploads. Do NOT set this when the
# database is shared with another app: it grants access to everything in it.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_ATELIER_UPLOADS=false
# Public project URL: needed only so the browser may PUT Atelier uploads (CSP connect-src).
NEXT_PUBLIC_SUPABASE_URL=

# ---- Email (optional; skipped gracefully when empty) -----------------
RESEND_API_KEY=
# Where new B2B / Atelier notifications go (comma-separated)
NOTIFY_EMAIL_TO=
# Must be a verified sender domain in Resend, e.g. "BLOB <hello@yourdomain.in>"
EMAIL_FROM=

# ---- Spam protection (optional; enabled when both are set) ------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Analytics (optional): Vercel Analytics works with no config ----
# Set to your domain to also load Plausible
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ---- Phase 2: reservations (keep disabled until launch) ------------------
NEXT_PUBLIC_ENABLE_PREORDER=false
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Refundable deposit in whole rupees, e.g. 500 (placeholder: DEPOSIT_AMOUNT)
RESERVATION_DEPOSIT_INR=
